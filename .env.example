# -----------------------------------------------------------------------------
# BCTech / BritosCode HQ — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NÃO deve ser versionado.
# -----------------------------------------------------------------------------

# Banco de dados (PostgreSQL) — usado pelo Prisma
DATABASE_URL="postgresql://usuario:senha@localhost:5432/bctech?schema=public"

# Supabase — painel do projeto em Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
