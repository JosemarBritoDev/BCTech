// Schema Prisma do ecossistema BCTech / BritosCode HQ
// Documentação: docs/DATABASE_SCHEMA.md
// Docs Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CLIENT
}

enum ProductStatus {
  ACTIVE
  BETA
  DEMO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  OVERDUE
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

// ---------------------------------------------------------------------------
// Identidade e acesso
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(CLIENT)
  avatarUrl String?
  accounts  Account[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Vínculo de identidade externa (OAuth/Supabase Auth) com um usuário.
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String   @default("oauth")
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ---------------------------------------------------------------------------
// Catálogo de produtos SaaS
// ---------------------------------------------------------------------------

model SaasProduct {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String
  status        ProductStatus @default(ACTIVE)
  demoUrl       String?
  repositoryUrl String?
  subscriptions Subscription[]
  demoSandboxes DemoSandbox[]
  tickets       Ticket[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("saas_products")
}

// ---------------------------------------------------------------------------
// Tenants (clientes do ecossistema)
// ---------------------------------------------------------------------------

model Tenant {
  id            String        @id @default(cuid())
  name          String
  document      String        @unique
  subscriptions Subscription[]
  tickets       Ticket[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Assinaturas (billing via Asaas)
// ---------------------------------------------------------------------------

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String
  saasProductId        String
  status               SubscriptionStatus @default(ACTIVE)
  planName             String
  asaasCustomerId      String?
  asaasSubscriptionId  String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saasProduct SaasProduct @relation(fields: [saasProductId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([saasProductId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Sandboxes de demonstração
// ---------------------------------------------------------------------------

model DemoSandbox {
  id            String   @id @default(cuid())
  saasProductId String
  tenantSlug    String
  expiresAt     DateTime
  isClean       Boolean  @default(true)
  createdAt     DateTime @default(now())

  saasProduct SaasProduct @relation(fields: [saasProductId], references: [id], onDelete: Cascade)

  @@unique([saasProductId, tenantSlug])
  @@index([tenantSlug])
  @@index([expiresAt])
  @@index([isClean])
  @@map("demo_sandboxes")
}

// ---------------------------------------------------------------------------
// Suporte
// ---------------------------------------------------------------------------

model Ticket {
  id            String         @id @default(cuid())
  tenantId      String
  saasProductId String
  title         String
  description   String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saasProduct SaasProduct @relation(fields: [saasProductId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([saasProductId])
  @@index([priority])
  @@map("tickets")
}
